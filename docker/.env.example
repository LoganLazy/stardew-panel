########################################
#  StardewPanel 部署配置示例
#  用法：cp .env.example .env 然后填写下面的值
########################################

########################################
#  必填
########################################

# 拥有《星露谷物语》的正版 Steam 账号（steam-auth 用它下载游戏文件）
STEAM_USERNAME=""
STEAM_PASSWORD=""

# VNC 网页密码（看游戏画面用）。公网部署必须设，别留空。
VNC_PASSWORD=""

# 游戏容器 REST API 的密钥。面板用它调游戏 API，也保护写接口。
# 生成：openssl rand -base64 32
# 公网部署强烈建议设置。
API_KEY=""

# 面板首次启动管理员账号。ADMIN_PASSWORD 至少 12 个字符。
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

########################################
#  端口（按需改，避免宿主端口冲突）
########################################

# 面板网页端口
PANEL_PORT=9090

# VNC 网页端口（看游戏画面）
VNC_PORT=5800

# 联机端口（UDP，玩家连这个）
GAME_PORT=24642

# Steam 查询端口（UDP）
QUERY_PORT=27015

########################################
#  可选：游戏服务器设置
########################################

# 联机密码，玩家进服要 !login <密码>。留空则不需要。
SERVER_PASSWORD=""

# 每秒 tick 数，默认 60。降到 20-30 省 CPU，代价是 NPC 移动略卡。
# 生产环境（尤其 2G/4G 小服务器）建议 30。
# SERVER_TPS=30

# 渲染帧率，0=关闭渲染（默认，最省资源）。>0 时才能通过 VNC 看到画面。
# 想用 VNC 看画面时设为如 10。
# SERVER_FPS=0

# 保留哪些语言的字体（影响下载体积）。默认 zh-CN 让中文正常显示。
# 逗号分隔，可选：de-DE,es-ES,fr-FR,ja-JP,ko-KR,ru-RU,zh-CN 等
STEAM_KEEP_LANGUAGES="zh-CN"

########################################
#  高级
########################################

# 固定的 sdvd 镜像版本。部署前请确认镜像仓库可访问，并完成游戏联调。
IMAGE_VERSION=1.0.0

# 允许在没设 VNC_PASSWORD / API_KEY 时启动（默认 false）。
# 仅限本机内网测试用，公网千万别开。
# ALLOW_INSECURE_SETUP=false

# 反向代理的 IP 或 CIDR，多个值用逗号分隔。留空时不信任 X-Forwarded-For。
# 仅填写你实际控制的代理地址，不要使用 0.0.0.0/0。
# TRUSTED_PROXIES="172.17.0.1"

# 已有 Steam refresh token 时可填（免重复登录）。
# 首次登录后导出：docker compose run --rm steam-auth export-token
# STEAM_REFRESH_TOKEN=""
